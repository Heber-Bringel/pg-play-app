{
  "name": "pg-play-app",
  "version": "1.0.0",
  "private": true,
  "description": "PG PLAY - Minigames para Pequenos Grupos (IHC + PDM)",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "arquitetura": "node scripts/check-arquitetura.mjs",
    "check": "node scripts/check-arquitetura.mjs && tsc --noEmit && jest --passWithNoTests",
    "spec:new": "node .specify/scripts/create-new-feature.mjs",
    "github:setup": "node scripts/setup-github-project.mjs",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "jest": "~30.5.2",
    "react-test-renderer": "19.3.0",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "main": "expo-router/entry"
}
